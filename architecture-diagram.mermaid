flowchart TB
    subgraph Clients["Clients"]
        C3[Client Service C]
        C1[Client Service A]
        C2[Client Service B]
    end

    subgraph OpsRow[" "]
        direction LR

        subgraph Backfill["Backfill"]
            direction TB
            BFJ["BackfillJob --backfill"]
            BFS[BackfillService]
            pull["1. Pull unmigrated rows"]
            upsert["2. Bulk upsert"]
            stamp["3. Set migrated_at"]
            CKPT[("backfill_checkpoint")]
            DLQ[(backfill_dlq)]
            BFJ --> BFS
            BFS --> pull
            pull --> upsert
            upsert --> stamp
            BFS -->|"success update checkpoint"| CKPT
            BFS -->|"advanceCheckpointPastFailure"| CKPT
            BFS -->|"failure record to DLQ"| DLQ
        end

        subgraph DlqTriage["DLQ triage"]
            direction TB
            CRON["Cron every minute npm run dlq"]
            DLQAGENT["dlq-agent.ts Cursor SDK"]
            FETCH["fetch unresolved DLQ rows"]
            PR["dlq-fix PR"]
            ISOLATE["Isolated compose :15432 / :37017"]
            CRON --> DLQAGENT
            DLQAGENT --> FETCH
            DLQAGENT --> PR
            DLQAGENT --> ISOLATE
        end
    end

    subgraph Shim["Migration Shim :8080"]
        direction TB
        CTRL[Controllers]
        DLQAPI["GET /admin/backfill/dlq"]
        SVC[Services]
        XFORM["Shared Transformers Customer Product Order"]
        RESOLVER[DataSourceResolver]
        CTRL -->|"GET / POST"| SVC
        SVC -->|"resolve DataSource"| RESOLVER
        SVC -->|"GET toResponse POST toDocument"| XFORM
    end

    subgraph DataSources["Data sources"]
        MONGO[(Mongo)]
        PG[(Postgres)]
    end

    C3 -->|"GET / POST"| CTRL
    C1 -->|"GET / POST"| CTRL
    C2 -->|"GET / POST"| CTRL

    RESOLVER -->|"migrated_at IS NULL"| PG
    RESOLVER -->|"migrated_at IS NOT NULL or ObjectId"| MONGO
    SVC -->|"POST create"| MONGO

    pull -->|"read"| PG
    upsert -->|"write"| MONGO
    stamp -->|"update"| PG
    CKPT -->|"start cursor"| BFS
    BFS --> XFORM
    DLQAPI --> DLQ
    FETCH --> DLQAPI

    classDef runtime fill:#e8d5ff,stroke:#7c3aed,stroke-width:1px
    classDef db fill:#d5f0ff,stroke:#0284c7,stroke-width:1px
    classDef artifact fill:#fff4d5,stroke:#d97706,stroke-width:1px

    class CTRL,SVC,RESOLVER,BFJ,BFS,DLQAGENT,FETCH,pull,upsert,stamp runtime
    class PG,MONGO,CKPT,DLQ db
    class XFORM artifact
